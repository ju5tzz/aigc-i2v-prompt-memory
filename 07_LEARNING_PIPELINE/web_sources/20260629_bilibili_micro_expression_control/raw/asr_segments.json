  {
    "start": 12.88,
    "end": 14.88,
    "text": "这些漫剧有一个共同点"
  },
  {
    "start": 14.88,
    "end": 16.88,
    "text": "就是人物表情僵硬的像木头人"
  },
  {
    "start": 16.88,
    "end": 18.88,
    "text": "喜怒哀乐全一个样"
  },
  {
    "start": 18.88,
    "end": 20.88,
    "text": "打斗戏没杀气"
  },
  {
    "start": 20.88,
    "end": 22.88,
    "text": "对手戏没情绪"
  },
  {
    "start": 22.88,
    "end": 24.88,
    "text": "高光时刻没感染力"
  },
  {
    "start": 24.88,
    "end": 26.88,
    "text": "看着就非常出戏"
  },
  {
    "start": 26.88,
    "end": 28.88,
    "text": "今天这节课咱们就把AI人物"
  },
  {
    "start": 28.88,
    "end": 30.88,
    "text": "真实表情精准控制这个痛点"
  },
  {
    "start": 30.88,
    "end": 32.88,
    "text": "彻底砸透 全程没有一句废话"
  },
  {
    "start": 32.88,
    "end": 34.88,
    "text": "落地的时操干货"
  },
  {
    "start": 34.88,
    "end": 36.88,
    "text": "以及经过上百次验证的"
  },
  {
    "start": 36.88,
    "end": 38.88,
    "text": "万能提示词模板"
  },
  {
    "start": 38.88,
    "end": 40.88,
    "text": "先从最基础最常用的方法讲起"
  },
  {
    "start": 40.88,
    "end": 42.88,
    "text": "适合80%的普通对话"
  },
  {
    "start": 42.88,
    "end": 44.88,
    "text": "常规情绪场景"
  },
  {
    "start": 44.88,
    "end": 46.88,
    "text": "这个方法的核心原理非常简单"
  },
  {
    "start": 46.88,
    "end": 48.88,
    "text": "把笼统的情绪词"
  },
  {
    "start": 48.88,
    "end": 50.88,
    "text": "拆解成眼睛 眉毛 嘴巴"
  },
  {
    "start": 50.88,
    "end": 52.88,
    "text": "面部肌肉"
  },
  {
    "start": 52.88,
    "end": 54.88,
    "text": "四个部位的具体细节描述"
  },
  {
    "start": 54.88,
    "end": 56.88,
    "text": "不要直写生气"
  },
  {
    "start": 56.88,
    "end": 58.88,
    "text": "高兴这种笼统的词语"
  },
  {
    "start": 58.88,
    "end": 60.88,
    "text": "AI就能100%还原你想要的情绪"
  },
  {
    "start": 60.88,
    "end": 62.88,
    "text": "西游短剧里最常用的"
  },
  {
    "start": 62.88,
    "end": 64.88,
    "text": "四种核心情绪都拆解成了"
  },
  {
    "start": 64.88,
    "end": 66.88,
    "text": "可直接套用的提示词"
  },
  {
    "start": 66.88,
    "end": 68.88,
    "text": "片段直接抄就行"
  },
  {
    "start": 68.88,
    "end": 70.88,
    "text": "这是单人物基础表情"
