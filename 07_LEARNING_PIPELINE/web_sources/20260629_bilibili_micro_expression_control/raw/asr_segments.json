  {
    "start": 6.88,
    "end": 8.88,
    "text": "报款短剧制作的第八节课"
  },
  {
    "start": 8.88,
    "end": 10.88,
    "text": "最近看了很多AI精品漫剧"
  },
  {
    "start": 10.88,
    "end": 12.88,
    "text": "我发现了一个很大的问题"
